# NEXORA CAMPUS Environment Configuration

# Database (Default: SQLite local file)
DATABASE_URL=sqlite:///./nexora_campus.db

# Groq LLM Configuration
# Provide your Groq API key below to enable LLM-generated explanations and narratives.
# If omitted or left empty, the application operates in 100% Deterministic Agent Mode.
GROQ_API_KEY=your_api_key
GROQ_MODEL=llama-3.3-70b-versatile
LLM_ENABLED=true

# Optimization & Solver Configuration
SOLVER_TIMEOUT_SECONDS=10
MAX_SCHEDULE_DISPLACEMENT_HOURS=4
