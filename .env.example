# ========================================================
# NEXORA CAMPUS - Configuration Settings
# ========================================================

# Model Provider ('groq' or 'gemini')
AGENTX_PROVIDER=groq

# Groq API Configuration (Free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Settings
DATABASE_URL=sqlite:///./nexora_campus.db

# Agentic Runtime Settings
MAX_ITERATIONS=6
SOLVER_TIMEOUT_SECONDS=10
LLM_ENABLED=true
